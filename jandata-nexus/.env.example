# JanData Nexus Frontend & Serverless Environment Variables

# Supabase Credentials (Public - Safe for browser JS client with RLS)
VITE_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# Serverless Groq API Endpoint (Defaults to local /api/groq or Vercel serverless)
# Set to your Supabase Edge Function URL if using Supabase Edge Functions:
# VITE_GROQ_SERVERLESS_URL=https://your-supabase-project-ref.supabase.co/functions/v1/groq-chat
VITE_GROQ_SERVERLESS_URL=/api/groq

# Optional override. By default the frontend uses the Supabase Edge Function:
# https://your-supabase-project-ref.supabase.co/functions/v1/jandata-query
# VITE_JANDATA_QUERY_URL=https://your-supabase-project-ref.supabase.co/functions/v1/jandata-query

# Secret Groq API Key (SERVER SIDE ONLY - NEVER commit to git or expose to client side)
# Set this in Vercel Environment Variables, Supabase Edge Secrets, or local .env
GROQ_API_KEY=gsk_your_groq_api_key_here
